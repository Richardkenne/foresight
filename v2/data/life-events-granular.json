  "_meta": {
    "description": "GRANULAR life event probabilities by SINGLE YEAR of age (18-100). Built for behavioral simulation engine. Official U.S. data with documented interpolation.",
    "version": "1.0.0",
    "created": "2026-03-27",
    "methodology": "Anchor points from official sources (marked [A]). Intermediate years derived via log-linear interpolation between anchors (marked [I]). All probabilities are ANNUAL (probability of event occurring in that specific year of age).",
